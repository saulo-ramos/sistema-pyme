# ─── Supabase real para pruebas de integración (producción) ────────────────────
# Copia este archivo a tests/.env.test y rellena los valores.
# NUNCA subas tests/.env.test al repositorio (ya está en .gitignore).

# Proyecto Supabase de pruebas/staging (diferente al de producción)
TEST_SUPABASE_URL=https://tu-proyecto.supabase.co
TEST_SUPABASE_ANON_KEY=eyJ...
TEST_SUPABASE_SERVICE_KEY=eyJ...  # service_role key — bypassa RLS, solo para setup/teardown

# Usuarios de prueba creados en el proyecto Supabase
TEST_USER_ADMIN_A_EMAIL=admin-a@tudominio.cl
TEST_USER_ADMIN_A_PASSWORD=ContraseñaSegura123!
TEST_USER_ADMIN_B_EMAIL=admin-b@tudominio.cl
TEST_USER_ADMIN_B_PASSWORD=ContraseñaSegura456!
TEST_USER_NO_TENANT_EMAIL=notenant@tudominio.cl
TEST_USER_NO_TENANT_PASSWORD=ContraseñaSegura789!
TEST_USER_VIEWER_EMAIL=vista@tudominio.cl
TEST_USER_VIEWER_PASSWORD=ContraseñaVista123!

# UUIDs de los tenants de prueba (obtenidos de la tabla tenants en Supabase)
TEST_TENANT_A_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEST_TENANT_B_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
